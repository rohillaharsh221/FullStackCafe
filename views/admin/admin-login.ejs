<!DOCTYPE html>
<html>
<head><script src="https://cdn.tailwindcss.com"></script></head>
<body class="bg-slate-900 flex items-center justify-center min-h-screen">
    <div class="bg-white p-8 rounded-xl shadow-2xl w-96">
        <h2 class="text-2xl font-bold text-slate-800 mb-6 text-center">Admin Portal</h2>
        <% if (error) { %> <p class="text-red-500 text-sm mb-4"><%= error %></p> <% } %>
        <form action="/admin-login" method="POST" class="space-y-4">
            <input type="email" name="email" placeholder="Admin Email" required class="w-full p-3 bg-slate-100 rounded border">
            <input type="password" name="password" placeholder="Security Key" required class="w-full p-3 bg-slate-100 rounded border">
            <button type="submit" class="w-full bg-slate-800 text-white py-3 rounded font-bold hover:bg-slate-700">Enter Dashboard</button>
        </form>
        <a href="/" class="block mt-4 text-center text-xs text-slate-400">← Back to Main Site</a>
    </div>
</body>
</html>