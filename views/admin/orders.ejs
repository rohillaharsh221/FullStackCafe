<!DOCTYPE html>
<html>
<head>
    <title>Live Orders | Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    </head>
<body class="bg-stone-100 p-8 text-stone-900">
    <div class="max-w-7xl mx-auto">
        <div class="bg-stone-900 text-white p-8 rounded-[2.5rem] flex justify-between items-center mb-10 shadow-2xl">
            <div>
                <h1 class="text-3xl font-black tracking-tighter italic text-orange-500 underline decoration-stone-700">Live Orders</h1>
                <p class="text-stone-400">Staff: <strong><%= admin.name %></strong></p>
            </div>
            <div class="flex space-x-4">
                <a href="/admin/dashboard" class="bg-stone-700 px-6 py-2 rounded-xl font-bold hover:bg-stone-600 transition">Manage Menu</a>
                <a href="/logout" class="bg-white/10 px-6 py-2 rounded-xl font-bold hover:bg-red-600 transition">Logout</a>
            </div>
        </div>

        <div class="bg-white shadow-xl rounded-[2.5rem] overflow-hidden border border-stone-200">
            <table class="w-full text-left">
                <thead class="bg-stone-50 text-stone-400 text-xs font-black uppercase tracking-widest">
                    <tr>
                        <th class="p-8">Client</th>
                        <th class="p-8">Items</th>
                        <th class="p-8">Total Price</th>
                        <th class="p-8">Status</th>
                        <th class="p-8 text-center">Manage</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-stone-100">
                    <% orders.forEach(order => { %>
                        <tr class="hover:bg-stone-50 transition">
                            <td class="p-8 font-bold"><%= order.customer %></td>
                            
                            <td class="p-8">
                                <ul class="text-xs space-y-1">
                                    <% if (order.items && order.items.length > 0) { %>
                                        <% order.items.forEach(i => { %>
                                            <li class="font-medium text-stone-600">
                                                <span class="font-bold text-stone-900"><%= i.name %></span> 
                                                (x<%= i.quantity %>)
                                            </li>
                                        <% }) %>
                                    <% } else { %>
                                        <li class="font-bold text-stone-800"><%= order.item %></li>
                                    <% } %>
                                </ul>
                            </td>

                            <td class="p-8 font-black text-orange-600">₹<%= order.totalPrice || order.price %></td>
                            
                            <td class="p-8">
                                <span id="admin-status-<%= order.orderId %>" class="px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest
                                    <%= order.status === 'Completed' ? 'bg-green-100 text-green-700' : 
                                       order.status === 'Preparing' ? 'bg-blue-100 text-blue-700' : 
                                       'bg-orange-100 text-orange-600' %>">
                                    <%= order.status %>
                                </span>
                            </td>

                            <td class="p-8 flex justify-center" id="actions-<%= order.orderId %>">
                                <% if (order.status === 'Pending') { %>
                                    <button onclick="changeStatus('<%= order.orderId %>', 'Preparing')" class="bg-blue-600 text-white px-5 py-2 rounded-xl text-xs font-bold hover:bg-blue-700 transition shadow-lg">Start Prep</button>
                                <% } else if (order.status === 'Preparing') { %>
                                    <button onclick="changeStatus('<%= order.orderId %>', 'Prepared')" class="bg-orange-600 text-white px-5 py-2 rounded-xl text-xs font-bold hover:bg-orange-700 transition shadow-lg">Mark Prepared</button>
                                <% } else if (order.status === 'Prepared') { %>
                                    <button onclick="changeStatus('<%= order.orderId %>', 'Completed')" class="bg-green-600 text-white px-5 py-2 rounded-xl text-xs font-bold hover:bg-green-700 transition shadow-lg">Finish Order</button>
                                <% } else { %>
                                    <span class="text-stone-300 italic text-sm font-bold">Order Served</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
    async function changeStatus(orderId, newStatus) {
        try {
            const response = await fetch('/update-order-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ orderId, status: newStatus })
            });

            if (response.ok) {
                // Reloading ensures all buttons and UI states update correctly
                location.reload(); 
            } else {
                alert("Failed to update status.");
            }
        } catch (err) {
            console.error(err);
        }
    }
    </script>
</body>
</html>