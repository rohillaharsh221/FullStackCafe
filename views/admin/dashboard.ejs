<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard | Script & Sip</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-stone-100 p-8 text-stone-900">
    <div class="max-w-7xl mx-auto">
        <div class="bg-stone-900 text-white p-8 rounded-[2.5rem] flex justify-between items-center mb-10 shadow-2xl">
            <div>
                <h1 class="text-3xl font-black tracking-tighter italic text-orange-500">Admin Control</h1>
                <p class="text-stone-400">Welcome back, <strong><%= admin.name %></strong></p>
            </div>
            <div class="flex space-x-4">
                <a href="/admin/orders" class="bg-orange-600 px-6 py-2 rounded-xl font-bold hover:bg-orange-700 transition">View Live Orders</a>
                <a href="/logout" class="bg-white/10 px-6 py-2 rounded-xl font-bold hover:bg-red-600 transition">Logout</a>
            </div>
        </div>

        <div class="bg-white p-8 rounded-[3rem] shadow-xl mb-12 border border-stone-200">
            <h2 class="text-2xl font-bold text-stone-800 mb-6 px-2">Add New Menu Item</h2>
            <form action="/admin/add-product" method="POST" class="flex flex-wrap gap-4 items-end">
                <div class="flex-1 min-w-[180px]">
                    <label class="text-xs font-bold text-stone-400 ml-2 uppercase">Item Name</label>
                    <input type="text" name="name" required class="w-full mt-1 p-3 bg-stone-50 border border-stone-100 rounded-xl outline-none focus:ring-2 focus:ring-orange-500 text-sm">
                </div>
                <div class="w-24">
                    <label class="text-xs font-bold text-stone-400 ml-2 uppercase">Price (₹)</label>
                    <input type="number" name="price" required class="w-full mt-1 p-3 bg-stone-50 border border-stone-100 rounded-xl outline-none focus:ring-2 focus:ring-orange-500 text-sm">
                </div>
                <div class="w-32">
                    <label class="text-xs font-bold text-stone-400 ml-2 uppercase">Category</label>
                    <select name="category" class="w-full mt-1 p-3 bg-stone-50 border border-stone-100 rounded-xl outline-none focus:ring-2 focus:ring-orange-500 text-sm">
                        <option value="Drinks">Drinks</option>
                        <option value="Snacks">Snacks</option>
                        <option value="Desserts">Desserts</option>
                    </select>
                </div>
                <div class="flex-1 min-w-[180px]">
                    <label class="text-xs font-bold text-stone-400 ml-2 uppercase">Image URL</label>
                    <input type="text" name="image" required class="w-full mt-1 p-3 bg-stone-50 border border-stone-100 rounded-xl outline-none focus:ring-2 focus:ring-orange-500 text-sm">
                </div>
                <div class="flex-1 min-w-[200px]">
                    <label class="text-xs font-bold text-stone-400 ml-2 uppercase">Description</label>
                    <input type="text" name="description" placeholder="Brief details..." class="w-full mt-1 p-3 bg-stone-50 border border-stone-100 rounded-xl outline-none focus:ring-2 focus:ring-orange-500 text-sm">
                </div>
                <button type="submit" class="bg-orange-600 text-white font-bold px-6 py-3.5 rounded-xl hover:bg-orange-700 transition shadow-md whitespace-nowrap">
                    Add Item
                </button>
            </form>
        </div>

        <div id="menu-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            <% menu.forEach(item => { %>
                <div class="menu-item bg-white p-6 rounded-[2.5rem] border border-stone-200 shadow-sm hover:shadow-xl transition-all relative group">
                    <img src="<%= item.image %>" class="w-full h-40 object-cover rounded-3xl mb-4 shadow-md <%= item.isAvailable ? '' : 'grayscale opacity-50' %>" onerror="this.src='https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?q=80&w=500'">
                    
                    <div class="mb-4">
                        <div class="flex justify-between items-start">
                            <h3 class="font-bold text-stone-800 text-lg leading-tight"><%= item.name %></h3>
                            <span class="<%= item.isAvailable ? 'text-green-600' : 'text-red-600' %> text-[10px] font-black uppercase tracking-widest">
                                <%= item.isAvailable ? 'In Stock' : 'Out Stock' %>
                            </span>
                        </div>
                        <p class="text-[10px] text-stone-400 uppercase font-black tracking-widest mt-1"><%= item.category %></p>
                        <p class="text-xs text-stone-500 mt-2 h-8 overflow-hidden line-clamp-2 italic"><%= item.description %></p>
                    </div>
                    
                    <div class="space-y-2">
                        <form action="/admin/toggle-stock" method="POST">
                            <input type="hidden" name="productId" value="<%= item._id %>">
                            <button type="submit" class="w-full py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest border transition-all 
                                <%= item.isAvailable ? 'border-amber-200 text-amber-600 hover:bg-amber-50' : 'border-green-200 text-green-600 hover:bg-green-50' %>">
                                Mark <%= item.isAvailable ? 'Out of Stock' : 'In Stock' %>
                            </button>
                        </form>

                        <form action="/admin/delete-product" method="POST" onsubmit="return confirm('Delete this item?')">
                            <input type="hidden" name="productId" value="<%= item._id %>">
                            <button type="submit" class="w-full bg-red-50 text-red-600 font-bold py-2.5 rounded-xl hover:bg-red-600 hover:text-white transition-all text-[10px] uppercase tracking-widest">
                                Remove Item
                            </button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</body>
</html>