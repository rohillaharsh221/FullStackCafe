<%- include('partials/header') %>
<div class="min-h-[80vh] flex items-center justify-center">
    <div class="bg-white p-8 rounded-2xl shadow-xl w-full max-w-md border">
        <h2 class="text-3xl font-bold text-center mb-6">User Login</h2>
        <% if (error) { %> <p class="text-red-500 text-center mb-4"><%= error %></p> <% } %>
        <form action="/login" method="POST" class="space-y-4">
            <input type="email" name="email" placeholder="Email" required class="w-full p-3 rounded-lg border outline-none focus:ring-2 focus:ring-amber-500">
            <input type="password" name="password" placeholder="Password" required class="w-full p-3 rounded-lg border outline-none focus:ring-2 focus:ring-amber-500">
            <button type="submit" class="w-full bg-amber-800 text-white py-3 rounded-lg font-bold">Login</button>
        </form>
        <p class="mt-4 text-center text-sm">Staff member? <a href="/admin-login" class="text-amber-700 underline">Admin Access</a></p>
    </div>
</div>
<%- include('partials/footer') %>