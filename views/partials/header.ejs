<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>The Full Stack Café</title>
</head>
<body class="bg-stone-50 text-stone-900">
    <nav class="bg-white/80 backdrop-blur-md border-b border-stone-200 p-4 sticky top-0 z-50">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <a href="/" class="text-2xl font-black text-stone-900 tracking-tighter">
                <span class="text-orange-600">FullStack</span>Café
            </a>
            <div class="space-x-6 flex items-center text-sm font-bold uppercase tracking-wider">
                <a href="/" class="hover:text-orange-600 transition">Menu</a>
                <% if (user) { %>
                    <a href="/my-orders" class="hover:text-orange-600 transition">My Orders</a>
                <% } %>
                <a href="/cart" class="hover:text-orange-600 transition">Cart</a>
                <% if (user) { %>
                    <span class="text-stone-400">|</span>
                    <span class="text-stone-800">Hi, <%= user.name %></span>
                    <a href="/logout" class="text-red-600 hover:underline">Logout</a>
                <% } else { %>
                    <a href="/login" class="text-stone-500 hover:text-stone-900">Login</a>
                    <a href="/signup" class="bg-stone-900 text-white px-6 py-2 rounded-full hover:bg-orange-600 transition shadow-lg">Signup</a>
                <% } %>
            </div>
        </div>
    </nav>