<%- include('../partials/header') %>
<div class="min-h-screen bg-stone-100 py-12 px-6">
    <div class="max-w-4xl mx-auto">
        <div class="flex items-center justify-between mb-10">
            <h2 class="text-4xl font-black italic text-stone-900">Order History</h2>
            <a href="/" class="text-orange-600 font-bold text-sm hover:underline uppercase tracking-widest">Back to Menu</a>
        </div>

        <% if (orders && orders.length > 0) { %>
            <div class="space-y-6">
                <% orders.forEach(order => { %>
                    <div class="bg-white p-8 rounded-[2.5rem] shadow-lg border border-stone-100 flex flex-col md:flex-row md:justify-between md:items-center gap-6">
                        <div class="flex-1">
                            <span class="text-[10px] font-black text-stone-400 uppercase tracking-widest block mb-3 opacity-60">ID: <%= order.orderId %></span>
                            
                            <div class="space-y-2">
                                <% if (order.items && order.items.length > 0) { %>
                                    <% order.items.forEach(i => { %>
                                        <div class="flex items-center gap-3">
                                            <div class="h-1.5 w-1.5 rounded-full bg-orange-500"></div>
                                            <h3 class="text-lg font-bold text-stone-800">
                                                <%= i.name %> <span class="text-stone-400 font-medium text-sm ml-2">x<%= i.quantity %></span>
                                            </h3>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <h3 class="text-lg font-bold text-stone-800"><%= order.item %></h3>
                                <% } %>
                            </div>
                        </div>

                        <div class="text-right flex flex-col items-end gap-3">
                            <p class="text-3xl font-black text-orange-600">₹<%= order.totalPrice || order.price %></p>
                            <span id="status-text-<%= order.orderId %>" class="px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest shadow-sm
                                <%= order.status === 'Completed' ? 'bg-green-100 text-green-700' : 
                                   order.status === 'Preparing' ? 'bg-blue-100 text-blue-700' : 
                                   'bg-orange-100 text-orange-600' %>">
                                <%= order.status === 'Pending' ? 'In Queue' : order.status %>
                            </span>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-24 bg-white rounded-[3rem] border border-dashed border-stone-300">
                <div class="text-5xl mb-6">☕</div>
                <p class="text-stone-400 font-bold mb-4">No orders found in your history.</p>
                <a href="/" class="inline-block bg-orange-600 text-white px-8 py-3 rounded-2xl font-black uppercase text-xs tracking-widest hover:bg-orange-700 transition">Order Something!</a>
            </div>
        <% } %>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    const currentCustomer = "<%= user ? user.name : '' %>";

    socket.on('order-status-updated', (data) => {
        if (data.customer === currentCustomer) {
            const statusEl = document.getElementById(`status-text-${data.orderId}`);
            if (statusEl) {
                statusEl.innerText = data.status;
                // Update colors dynamically
                statusEl.className = `px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest shadow-sm ${
                    data.status === 'Completed' ? 'bg-green-100 text-green-700' : 
                    data.status === 'Preparing' ? 'bg-blue-100 text-blue-700' : 'bg-orange-100 text-orange-600'
                }`;
            }
        }
    });
</script>

<%- include('../partials/footer') %>