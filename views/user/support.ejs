<%- include('../partials/header') %>
<div class="min-h-screen bg-[#FAF9F6] py-20 px-6">
    <div class="max-w-2xl mx-auto bg-white p-10 rounded-[3rem] shadow-2xl border border-stone-100">
        <h2 class="text-4xl font-black mb-4 italic text-stone-900">How can we help?</h2>
        <form id="supportForm" class="space-y-6">
            <input type="text" id="subject" placeholder="Subject" required class="w-full p-4 bg-stone-50 rounded-2xl border-none outline-none focus:ring-2 focus:ring-[#EA580C]">
            <textarea id="message" rows="5" placeholder="Tell us more..." required class="w-full p-4 bg-stone-50 rounded-2xl border-none outline-none focus:ring-2 focus:ring-[#EA580C]"></textarea>
            <button type="submit" class="w-full bg-[#1C1917] text-white py-5 rounded-[2rem] font-black text-lg hover:bg-[#EA580C] transition shadow-xl">
                Send Message
            </button>
        </form>
    </div>
</div>

<script>
document.getElementById('supportForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const res = await fetch('/support/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            subject: document.getElementById('subject').value,
            message: document.getElementById('message').value
        })
    });
    if (res.ok) {
        alert('Ticket Submitted! We will get back to you soon.');
        window.location.href = '/';
    }
});
</script>
<%- include('../partials/footer') %>